{
  "schema": "agent/1",
  "effort": {"planner": "high", "executor": "low", "diagnoser": "high", "summarizer": "medium"},
  "max_attempts": 3,
  "plateau_nodes": 5,
  "behind_schedule": {"spent_ratio": 0.5, "progress_ratio": 0.5},
  "explore_every": 4,
  "query_k": 4,
  "prompts": {
    "planner": "config/prompts/planner_lean.md",
    "executor": "config/prompts/executor_lean.md",
    "diagnoser": "config/prompts/diagnoser.md",
    "summarizer": "config/prompts/summarizer.md"
  },
  "library_rules": {
    "init_credibility": 0.5, "win_delta": 0.1, "loss_delta": -0.15,
    "demote_below": 0.3, "retire_after_losses": 3,
    "skill_min_credibility": 0.7, "skill_min_tasks": 2, "tool_min_tasks": 2,
    "max_experiences": 200, "max_skills": 30, "max_tools": 30
  },
  "stop_loss": {"tab": {"first_n_no_gain": 2}, "spd": {"consecutive_no_gain": 4}},
  "ceiling_excludes_baseline": true,
  "planner_mode": "lean",
  "hypotheses_per_plan": 5,
  "failure_feedback": true,
  "cost_priors": {"spd": 2500, "tab": 8000},
  "experience_writer": "script",
  "summarizer_reserve": "worst_case",
  "library_brief": {"min_credibility": 0.5, "max_chars": 300}
}
