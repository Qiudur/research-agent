{
  "schema": "agent/1",
  "effort": {
    "planner": "medium",
    "executor": "low",
    "diagnoser": "medium",
    "summarizer": "low"
  },
  "max_attempts": 3,
  "plateau_nodes": 5,
  "behind_schedule": {
    "spent_ratio": 0.5,
    "progress_ratio": 0.5
  },
  "explore_every": 4,
  "query_k": 8,
  "prompts": {
    "planner": "config/prompts/planner_token_pilot_v2.md",
    "executor": "config/prompts/executor_token_pilot_v2.md",
    "diagnoser": "config/prompts/diagnoser_token_pilot_v2.md",
    "summarizer": "config/prompts/summarizer.md"
  },
  "library_rules": {
    "init_credibility": 0.5,
    "win_delta": 0.1,
    "loss_delta": -0.15,
    "demote_below": 0.3,
    "retire_after_losses": 3,
    "skill_min_credibility": 0.7,
    "skill_min_tasks": 2,
    "tool_min_tasks": 2,
    "max_experiences": 200,
    "max_skills": 30,
    "max_tools": 30
