+    """Compute exact Levenshtein edit distance.
+    
+    Uses a single array with O(min(|a|,|b|)) space, reducing memory overhead
+    while maintaining correctness with the original implementation.
+    """
+    n, m = len(a), len(b)
+    
+    if n == 0:
+        return m
+    if m == 0:
+        return n
+    
+    # Ensure b is the shorter string for O(min(n,m)) space
+    if n < m:
+        a, b = b, a
+        n, m = m, n
+    
+    # Single array for DP, initialized to base case (distance from empty a)
+    dist = list(range(m + 1))
+    
+    for i in range(1, n + 1):
+        prev = dist[0]
+        dist[0] = i
+        for j in range(1, m + 1):
+            temp = dist[j]
+            if a[i - 1] == b[j - 1]:
+                dist[j] = prev
+            else:
+                dist[j] = 1 + min(prev, dist[j - 1], dist[j])
+            prev = temp
+    
+    return dist[m]
